APP_NAME=ai-video-api
APP_VERSION=0.1.0
APP_ENV=local
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=mysql+pymysql://app:change-me@host.docker.internal:13306/ai_video_text?charset=utf8mb4
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true
HEALTH_CHECK_DATABASE=true

AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_EXPIRE_SECONDS=604800
DOWNLOAD_TICKET_EXPIRE_SECONDS=60
ADMIN_MOBILE_WHITELIST=

INIT_POINTS=100
SECONDS_PER_POINT=6

PAYMENT_DUPLICATE_ORDER_WINDOW_SECONDS=120
MOCK_PAY_URL_PREFIX=https://mock-pay.local/qrcode/
FIRST_RECHARGE_GIFT_AMOUNT=9.90
FIRST_RECHARGE_GIFT_POINTS=1000
POINT_PACK_AMOUNT=19.90
POINT_PACK_POINTS=1000
POINT_PACK_PLUS_AMOUNT=59.90
POINT_PACK_PLUS_POINTS=3500
INVITE_REWARD_RATE_PERCENT=10
MIN_WITHDRAWAL_AMOUNT=10.00

STORAGE_ROOT=storage
UPLOAD_SUBDIR=uploads
MAX_UPLOAD_SIZE_BYTES=524288000

TASK_WORKER_MAX_WORKERS=2
FFMPEG_COMMAND=ffmpeg
FFPROBE_COMMAND=ffprobe
AUDIO_SUBDIR=audio

ASR_PROVIDER=volcengine
ASR_MOCK_ENABLED=false
ASR_TIMEOUT_SECONDS=180
ASR_VOLCENGINE_MODE=flash
ASR_VOLCENGINE_BASE_URL=https://openspeech.bytedance.com
ASR_VOLCENGINE_FLASH_PATH=/api/v3/auc/bigmodel/recognize/flash
ASR_VOLCENGINE_API_KEY=
ASR_VOLCENGINE_APP_ID=
ASR_VOLCENGINE_ACCESS_TOKEN=
ASR_VOLCENGINE_CLUSTER=
ASR_VOLCENGINE_RESOURCE_ID=volc.bigasr.auc_turbo
ASR_VOLCENGINE_MODEL_NAME=bigmodel
ASR_VOLCENGINE_UID_PREFIX=ai-video2text

MEDIA_IMPORT_WORKER_MAX_WORKERS=1
IMPORT_SUBDIR=imports
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
PLAYWRIGHT_TIMEOUT_SECONDS=30
PLAYWRIGHT_USER_AGENT=
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
IMPORT_DOWNLOAD_TTL_SECONDS=3600
MEDIA_CLEANUP_INTERVAL_SECONDS=60

# 一人付：仅在服务端配置，先执行 migration-opcpay.sql
opcpay_api_key=
OPCPAY_ENABLED=false
# 必须 HTTPS 且与一人付项目官网同主机、端口，不能用 localhost
OPCPAY_CALLBACK_URL=https://your-domain.example/payment

# QQ 邮箱验证码邮件：SMTP_PASSWORD 填授权码，不填 QQ 登录密码。Outlook OAuth2 可选配置保留如下
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_AUTH_MODE=password
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_TENANT=consumers
SMTP_OAUTH_TOKEN_FILE=.secrets/outlook-token.json
# 通用 SMTP 服务可选择 password 模式，凭据只放服务端
SMTP_PASSWORD=
ADMIN_EMAIL_WHITELIST=
INVITE_REWARD_HOLD_DAYS=7
SMTP_SECURITY=ssl
